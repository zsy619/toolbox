    <!-- Mobile Menu Script -->

    <!-- Horizontal Scroll Detection (Dev Only) -->

    <!-- =========================================================
         异步封面加载器（cover-loader.js）
         - 自动为 .book-card / .featured-card 注入 SVG 封面
         - 使用 loading="lazy" + IntersectionObserver 双重异步
         - 加载失败显示默认 📚 图标
         - 不修改 1000+ 个静态卡片 HTML
         ========================================================= -->
    <script>
    (function() {
        'use strict';
        if (window.__coverLoaderInit) return;
        window.__coverLoaderInit = true;

        const DEFAULT_ICON_BOOK =
            '<svg viewBox="0 0 24 24" width="48" height="48" fill="currentColor" ' +
            'style="opacity:0.35;filter:drop-shadow(0 2px 4px rgba(0,0,0,0.15))" ' +
            'aria-hidden="true">' +
            '<path d="M19 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h13a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1zm-1 17H6a1 1 0 0 1 0-2h12v2zm0-4H6V4h12v11z"/>' +
            '</svg>';

        function makeFallback(sizeClass) {
            const wrap = document.createElement('div');
            wrap.className = 'book-cover-default';
            wrap.setAttribute('aria-hidden', 'true');
            wrap.style.cssText =
                'position:absolute;inset:0;display:flex;align-items:center;' +
                'justify-content:center;pointer-events:none;z-index:0;';
            const isFeatured = sizeClass === 'featured';
            wrap.innerHTML = isFeatured
                ? DEFAULT_ICON_BOOK.replace('width="48"', 'width="72"').replace('height="48"', 'height="72"')
                : DEFAULT_ICON_BOOK;
            return wrap;
        }

        function setupCard(card) {
            const href = card.getAttribute('href');
            if (!href || !href.endsWith('.html')) return;
            if (/^https?:|^[/]{2}/.test(href)) return;

            const slug = href.split('/').pop().replace(/\.html$/, '');
            if (!slug) return;

            const isFeatured = card.classList.contains('featured-card');
            const wrapper = isFeatured
                ? card.querySelector('.featured-card-content')
                : card.querySelector('.book-cover-wrapper');
            const host = wrapper || card;
            if (host.querySelector('.book-cover-img, .book-cover-default')) return;

            // Ensure positioned parent
            const cs = getComputedStyle(host);
            if (cs.position === 'static') host.style.position = 'relative';

            const img = document.createElement('img');
            img.className = 'book-cover-img';
            img.alt = '';
            img.decoding = 'async';
            img.style.cssText =
                'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;' +
                'opacity:0;transition:opacity .35s ease;z-index:0;pointer-events:none;' +
                'background:transparent;';
            img.dataset.coverSrc = 'covers/' + encodeURIComponent(slug) + '.svg';

            img.addEventListener('load', function() {
                this.style.opacity = '1';
            });
            img.addEventListener('error', function() {
                this.remove();
                host.appendChild(makeFallback(isFeatured ? 'featured' : 'book'));
            });

            host.appendChild(img);

            // 双重异步：loading='lazy' + IntersectionObserver 兜底
            if ('loading' in HTMLImageElement.prototype) {
                img.loading = 'lazy';
            }
            if ('IntersectionObserver' in window) {
                const io = new IntersectionObserver((entries, obs) => {
                    entries.forEach(e => {
                        if (e.isIntersecting) {
                            const el = e.target;
                            el.src = el.dataset.coverSrc;
                            obs.unobserve(el);
                        }
                    });
                }, { rootMargin: '120px 0px', threshold: 0.01 });
                io.observe(img);
            } else {
                img.src = img.dataset.coverSrc;
            }
        }

        function init() {
            const cards = document.querySelectorAll(
                '.book-card[href$=".html"], .featured-card[href$=".html"]'
            );
            cards.forEach(setupCard);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
        } else {
            init();
        }
    })();
    </script>

    <!-- =========================================================
         移动端底部 Tab Bar（md 以下显示）
         ========================================================= -->
    <nav class="bottom-tab-bar md:hidden" aria-label="移动端导航">
        <a href="#featured" class="active" aria-label="精选">
            <i class="fa-solid fa-star"></i><span>精选</span>
        </a>
        <a href="#library" aria-label="书库">
            <i class="fa-solid fa-book-open"></i><span>书库</span>
        </a>
        <a href="#mood" aria-label="心情">
            <i class="fa-solid fa-mug-hot"></i><span>心情</span>
        </a>
        <a href="https://tools.yy24365.com" aria-label="工具箱">
            <i class="fa-solid fa-house"></i><span>工具箱</span>
        </a>
    </nav>

    <script>
    // ===== 多端增强 · 滚动揭示 + 移动 Tab 高亮 =====
    (function() {
        'use strict';
        if (window.__multiDeviceInit) return;
        window.__multiDeviceInit = true;

        // 1) IntersectionObserver 滚动揭示
        const revealTargets = document.querySelectorAll(
            '.book-card, .featured-card, .stat-card, .related-card'
        );
        if ('IntersectionObserver' in window) {
            const io = new IntersectionObserver((entries) => {
                entries.forEach((e, i) => {
                    if (e.isIntersecting) {
                        e.target.classList.add('reveal', 'in');
                        e.target.style.transitionDelay = (i % 8) * 40 + 'ms';
                        io.unobserve(e.target);
                    }
                });
            }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
            revealTargets.forEach(el => {
                el.classList.add('reveal');
                io.observe(el);
            });
        } else {
            revealTargets.forEach(el => el.classList.add('reveal', 'in'));
        }

        // 2) 移动端 Tab Bar：滚动时高亮当前区段
        const tabBar = document.querySelector('.bottom-tab-bar');
        if (tabBar) {
            const tabs = tabBar.querySelectorAll('a[href^="#"]');
            const sectionMap = new Map();
            tabs.forEach(t => {
                const id = t.getAttribute('href').slice(1);
                const sec = document.getElementById(id);
                if (sec) sectionMap.set(sec, t);
            });
            if ('IntersectionObserver' in window) {
                const sio = new IntersectionObserver((entries) => {
                    entries.forEach(e => {
                        const t = sectionMap.get(e.target);
                        if (!t) return;
                        if (e.isIntersecting) {
                            tabs.forEach(x => x.classList.remove('active'));
                            t.classList.add('active');
                        }
                    });
                }, { rootMargin: '-40% 0px -55% 0px' });
                sectionMap.forEach((_, sec) => sio.observe(sec));
            }
        }

        // 3) 分类 Accent 同步：hover 卡片时短暂把 hero accent 改为该书分类
        const cards = document.querySelectorAll('.book-card[data-cat]');
        if (cards.length && window.matchMedia('(hover: hover)').matches) {
            const hero = document.querySelector('.hero-section');
            cards.forEach(c => {
                c.addEventListener('mouseenter', () => {
                    const cat = c.dataset.cat;
                    const map = {
                        '哲学': '#818CF8', '商业': '#F59E0B', '科学': '#14B8A6',
                        '文学': '#F472B6', '自我成长': '#FB923C', '领导力': '#6366F1',
                        '财富': '#FACC15', '历史': '#A78BFA', '心理': '#34D399',
                        '思维认知': '#34D399'
                    };
                    if (hero && map[cat]) {
                        hero.style.setProperty('--cat-hover', map[cat]);
                    }
                });
            });
        }

        // 4) 滚动到底部时隐藏 nav（移动端体验）
        let lastY = 0, ticking = false;
        const nav = document.querySelector('.nav-glass');
        function onScroll() {
            const y = window.scrollY;
            if (!ticking) {
                requestAnimationFrame(() => {
                    if (nav && window.innerWidth < 768) {
                        if (y > lastY && y > 200) {
                            nav.style.transform = 'translateY(-100%)';
                        } else {
                            nav.style.transform = 'translateY(0)';
                        }
                    }
                    lastY = y;
                    ticking = false;
                });
                ticking = true;
            }
        }
        if (nav) {
            nav.style.transition = 'transform 0.3s cubic-bezier(0.16,1,0.3,1)';
            window.addEventListener('scroll', onScroll, { passive: true });
        }
    })();
    </script>
<!-- ui-ux-max 全站统一增强脚本 (阅读进度条/返回顶部/暗色切换/skip link) -->
<script src="assets/scripts/ui-ux-max.js" defer></script>
