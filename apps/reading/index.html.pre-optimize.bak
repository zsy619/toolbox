    <style>
/* ============================================
   ui-ux-pro-max 全局规范 (DESIGN.md v2.0)
   ============================================ */

/* 字体栈统一 */
html, body {
    font-family: var(--font-sans, 'Inter', 'PingFang SC', 'Noto Sans SC', system-ui, sans-serif);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    color: var(--ink, #141413);
    background-color: var(--canvas, #faf9f5);
    line-height: 1.65;
}

h1, h2, h3, h4, h5, h6,
.hero-title, .section-title, .featured-card-title, .book-title, .gradient-text {
    font-family: var(--font-display, 'Cormorant Garamond', 'Songti SC', 'Noto Serif SC', serif);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--ink, #141413);
}

/* 容器与布局规范 */
.content-container {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding-left: clamp(1rem, 3vw, 2rem);
    padding-right: clamp(1rem, 3vw, 2rem);
    width: 100%;
    box-sizing: border-box;
}

/* 导航统一 */
.nav-glass {
    background: rgba(250, 249, 245, 0.85);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--hairline, #e6dfd8);
}

/* 按钮统一 (DESIGN.md: 12px 20px padding, h40px, r8px) */
.btn-primary, .nav-link-cta, .featured-card-cta {
    background-color: var(--brand-primary, #cc785c);
    color: #ffffff !important;
    border: 1px solid var(--brand-primary, #cc785c);
    border-radius: 8px;
    padding: 12px 20px;
    height: 40px;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    transition: background-color 0.2s ease, transform 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
}
.btn-primary:hover, .nav-link-cta:hover, .featured-card-cta:hover {
    background-color: var(--brand-primary-active, #a9583e);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(204, 120, 92, 0.3);
}

/* 卡片统一 */
.book-card, .featured-card, .mood-card {
    background: #ffffff;
    border: 1px solid var(--hairline, #e6dfd8);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: block;
    text-decoration: none;
    color: inherit;
}
.book-card:hover, .featured-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(20, 20, 19, 0.08);
    border-color: var(--brand-primary, #cc785c);
}

/* 书库网格 */
/* 修复 v3.0: book-grid 强制规范 */
.book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px;
    padding: 16px 0;
    align-items: start;
    width: 100%;
    box-sizing: border-box;
}

/* 响应式：平板 (≤768px) - 缩小最小列宽到 140px */
@media (max-width: 768px) {
    .book-grid {
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: 12px;
    }
}

/* 响应式：手机 (≤480px) - 强制 2 列布局 */
@media (max-width: 480px) {
    .book-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }
    .book-card .book-title {
        font-size: 12px;
        line-height: 1.3;
        padding: 6px 8px;
    }
    .book-card .book-meta {
        font-size: 10px;
        padding: 4px 6px;
    }
}

/* ============================================
   Featured Card 样式 (编辑精选) - Premium Editorial
   ============================================ */
.featured-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 8px 0;
}
.featured-card {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #ffffff 0%, #faf9f5 100%);
    border: 1px solid var(--hairline, #e6dfd8);
    border-radius: 14px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: block;
    text-decoration: none;
    color: inherit;
}
.featured-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(20, 20, 19, 0.08);
    border-color: var(--brand-primary, #cc785c);
}
.featured-card-content {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    grid-template-rows: auto auto;
    grid-template-areas:
        "icon title cta"
        "icon text  cta";
    align-items: center;
    column-gap: 16px;
    row-gap: 2px;
    padding: 14px 18px;
}
.featured-card-icon {
    grid-area: icon;
    font-size: 28px;
    line-height: 1;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--canvas, #faf9f5);
    border-radius: 10px;
    flex-shrink: 0;
}
.featured-card-title {
    grid-area: title;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink, #141413);
    margin: 0;
    align-self: end;
}
.featured-card-author {
    grid-area: text;
    font-size: 12px;
    color: var(--muted, #6c6a64);
    margin: 0;
    align-self: start;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.featured-card-desc {
    display: block;  /* Google Design 修订:重新启用,显示必读理由 */
    font-style: italic;
    font-size: 13px;
    line-height: 1.5;
    color: var(--body, #3d3d3a);
    margin: 4px 0 0;
    max-width: 64ch;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}
.featured-badge {
    display: inline-flex;  /* Google Design 修订:重新启用 */
}
.featured-card-cta {
    grid-area: cta;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: #ffffff;
    background-color: var(--brand-primary, #cc785c);
    border: 1px solid var(--brand-primary, #cc785c);
    border-radius: 8px;
    padding: 8px 14px;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
}
.featured-card-cta:hover {
    background-color: var(--brand-primary-active, #a9583e);
    transform: translateX(2px);
}

/* 平板 featured-card 优化 */
@media (max-width: 768px) {
    .featured-card-content {
        grid-template-columns: 44px 1fr;
        gap: 12px;
        padding: 12px 14px;
    }
    .featured-card-icon {
        width: 44px;
        height: 44px;
        font-size: 24px;
    }
    .featured-card-cta {
        grid-column: 1 / -1;
        justify-content: center;
        padding: 8px 12px;
        font-size: 13px;
        margin-top: 4px;
    }
    .featured-card-title {
        font-size: 15px;
    }
}

/* 章节标题 */
.section-header {
    text-align: center;
    margin: 3rem 0 2rem;
}
.section-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 0.5rem;
}
.section-subtitle {
    color: var(--muted, #6c6a64);
    font-size: 1rem;
}

/* 分类筛选器 */
.chip-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 1.5rem;
}
.cat-chip, .diff-chip {
    background: #ffffff;
    border: 1px solid var(--hairline, #e6dfd8);
    border-radius: 9999px;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--body, #3d3d3a);
    cursor: pointer;
    transition: all 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
}
.cat-chip:hover, .diff-chip:hover {
    border-color: var(--brand-primary, #cc785c);
    color: var(--brand-primary, #cc785c);
}
.cat-chip.active, .diff-chip.active {
    background: var(--brand-primary, #cc785c);
    color: #ffffff;
    border-color: var(--brand-primary, #cc785c);
}

/* 英雄区 */
.hero-section {
    padding: 64px 0;
    background-color: var(--canvas);
    position: relative;
    z-index: 1;
}
.hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    margin-bottom: 1rem;
}
.gradient-text {
    background: linear-gradient(135deg, #cc785c 0%, #a9583e 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* 统计卡片 */
.stat-card {
    background: #ffffff;
    border: 1px solid var(--hairline, #e6dfd8);
    border-radius: 12px;
    padding: 1.5rem 1rem;
    text-align: center;
}
.stat-value {
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 600;
    color: var(--brand-primary, #cc785c);
    line-height: 1;
}

/* 搜索框 */
.search-container {
    position: relative;
    max-width: 640px;
    margin: 2rem auto 0;
}
.search-input {
    width: 100%;
    padding: 1rem 1.25rem 1rem 3rem;
    background: #ffffff;
    border: 1px solid var(--hairline, #e6dfd8);
    border-radius: 9999px;
    font-size: 1rem;
    color: var(--ink, #141413);
    transition: all 0.2s;
    box-sizing: border-box;
}
.search-input:focus {
    outline: none;
    border-color: var(--brand-primary, #cc785c);
    box-shadow: 0 0 0 4px rgba(204, 120, 92, 0.1);
}
.search-icon {
    position: absolute;
    left: 1.25rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted, #6c6a64);
    pointer-events: none;
}

/* 隐藏无意义装饰 */
.blob, .hero-bg-grid, .reading-progress {
    pointer-events: none;
    z-index: 0;
}

/* 响应式修复 */
@media (max-width: 768px) {
    .hero-section { padding: 2.5rem 0 2rem; }
    .content-container { padding-left: 1rem; padding-right: 1rem; }
    .stat-value { font-size: 1.75rem; }
    .book-grid { gap: 0.75rem; }
}

/* 移除深色背景干扰 - 仅作用于 body，避免破坏内联小元素 */
body</style>
</head>

<body style="width: 100%; max-width: 100%; overflow-x: hidden;; width: 100%; max-width: 100%;; width: 100%; max-width: 100%;; width: 100%; max-width: 100%;; width: 100%; max-width: 100%;" class="scroll-smooth">
    <!-- Reading Progress -->
    <div class="reading-progress" id="readingProgress" role="progressbar" aria-label="阅读进度"></div>

    <!-- Decorative Blobs -->
    <div class="blob blob-1" aria-hidden="true"></div>
    <div class="blob blob-2" aria-hidden="true"></div>
    <div class="blob blob-3" aria-hidden="true"></div>

    <!-- Skip to Content Link (A11y) -->
    <a href="#main-content" class="skip-link">跳转到主内容</a>

    <!-- Navigation -->
    <nav class="nav-glass sticky top-0 z-50" aria-label="主导航">
        <div class="content-container">
            <div class="flex items-center justify-between h-16">
                <a href="index.html" class="flex items-center space-x-3" aria-label="工具箱阅读首页">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background: var(--gold-gradient);">
                        <i class="fa-solid fa-book-open-reader text-gray-900 text-lg"></i>
                    </div>
                    <div>
                        <h1 class="text-base font-bold text-[var(--primary)]">阅读资源大全</h1>
                        <p class="text-xs text-muted">791本经典 · 编辑精选</p>
                    </div>
                </a>
                <div class="hidden md:flex items-center gap-6">
                    <a href="#featured" class="nav-link text-sm font-medium">精选</a>
                    <a href="#mood" class="nav-link text-sm font-medium">心情</a>
                    <a href="#library" class="nav-link text-sm font-medium">书库</a>
                    <a href="https://tools.yy24365.com" class="nav-link text-sm font-medium">
                        <i class="fa-solid fa-house mr-1"></i>工具箱
                    </a>
                </div>
                <a href="#library" class="nav-link-cta">
                    <i class="fa-solid fa-rocket mr-1"></i>开始阅读
                </a>
            </div>
        </div>
    </nav>

    <!-- Skip Link Styles (inline so it's first paint) -->
<main id="main-content">
        <!-- Hero Section -->
        <header class="hero-section">
            <div class="hero-bg-grid" aria-hidden="true"></div>
            <div class="content-container text-center relative z-10">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full mb-6" style="background: rgba(232, 165, 90, 0.12); border: 1px solid rgba(232, 165, 90, 0.3);">
                    <i class="fa-solid fa-sparkles text-[var(--primary)]"></i>
                    <span class="text-amber-300 text-sm font-semibold">编辑精选 · 必读经典</span>
                </div>

                <h2 class="hero-title mb-6">
                    <span class="gradient-text">791本</span>
                    <span class="text-[var(--body)]">经典书籍</span>
                    <br>
                    <span class="text-[var(--body)]">深度解读</span>
                    <span class="gradient-text">合集</span>
                </h2>

                <p class="text-lg sm:text-xl text-body max-w-3xl mx-auto mb-10 leading-relaxed">
                    哲学 · 心理 · 商业 · 财富 · 文学 · 历史 · 自我成长<br>
                    每本书都是<span class="gradient-text-soft font-semibold">一扇通往新世界的门</span>
                </p>

                <!-- Stats Grid (MD3 elevation + animated) -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto mb-10">
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fa-solid fa-book"></i></div>
                        <div class="stat-value" data-target="791">0</div>
                        <div class="text-xs text-muted mt-1">精选书籍</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fa-solid fa-layer-group"></i></div>
                        <div class="stat-value" data-target="11">0</div>
                        <div class="text-xs text-muted mt-1">主题分类</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fa-solid fa-clock"></i></div>
                        <div class="stat-value">10-40<span class="text-base">分钟</span></div>
                        <div class="text-xs text-muted mt-1">单本阅读时间</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fa-solid fa-palette"></i></div>
                        <div class="stat-value">v3.0</div>
                        <div class="text-xs text-muted mt-1">精选版本</div>
                    </div>
                </div>

